# Скопируй этот файл в .env и подставь свои значения.
# Сам .env в git не попадает.

# база данных (появится вместе с data-service)
DB_URL=jdbc:postgresql://localhost:5432/cybersystems
DB_USER=cybersystems
DB_PASSWORD=

# секрет для подписи JWT (появится вместе с auth-service)
JWT_SECRET=

# общий токен между сервисами (заголовок X-Internal-Token), придумай любую длинную строку
INTERNAL_TOKEN=
